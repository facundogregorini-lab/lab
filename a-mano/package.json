{
  "name": "a-mano",
  "version": "0.1.0",
  "private": true,
  "description": "A mano · MVP de billetera de acompañamiento (demo con datos ficticios y dinero simulado)",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "demo": "next build && next start -H 0.0.0.0 -p 3000",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "test": "vitest run",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:mobile": "node scripts/mobile-walkthrough.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "better-sqlite3": "^12.4.1",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
